# ============================================================
# Ekip Konum Takibi - Ortam Değişkenleri Şablonu
# ============================================================
# Bu dosyayı kopyalayıp ".env.local" adıyla kaydedin ve
# kendi değerlerinizi girin. GERÇEK ANAHTAR/SIR İÇERMEZ.
#
#   cp .env.local.example .env.local
#
# .env.local dosyası .gitignore içinde olduğu için commit
# edilmez / GitHub'a gönderilmez.
# ============================================================

# --- Davet Kodu ---
# Ekip üyelerinin katılım sayfasında (/join) gireceği paylaşılan kod.
# Üretimde varsayılan "EKIP2024" değerini mutlaka değiştirin.
INVITE_CODE=EKIP2024

# --- Ekip Boyutu ---
# Bu araç küçük, rızaya dayalı bir ekip için tasarlanmıştır (varsayılan 4).
MAX_TEAM_MEMBERS=4

# --- Konum Güncelleme / Panoya Yenileme Aralıkları (ms) ---
# Cihazın konumunu ne sıklıkla gönderdiği (varsayılan 45000 ms = 45 sn).
NEXT_PUBLIC_LOCATION_UPDATE_INTERVAL_MS=45000

# Bir üyenin son güncellemesi bu süreden (ms) daha eskiyse
# panoda "bayat / çevrimdışı" olarak gösterilir (varsayılan 120000 ms = 2 dk).
STALE_THRESHOLD_MS=120000

# Panonun sunucudan verileri ne sıklıkla yenilediği (varsayılan 15000 ms = 15 sn).
NEXT_PUBLIC_DASHBOARD_POLL_INTERVAL_MS=15000

# ============================================================
# --- Gerçek Veritabanı (opsiyonel, önerilir) ---
# ============================================================
# Uygulama varsayılan olarak bellek-içi (in-memory) depolama kullanır.
# Bu, sunucu her yeniden başladığında veya Vercel'de farklı bir
# sunucusuz (serverless) örneğe düştüğünde veriyi KAYBEDEBİLİR.
# Kalıcı ve güvenilir bir kurulum için Vercel Postgres veya Supabase
# kullanmanız önerilir. Kendi anahtarlarınızı buraya girin
# (bu anahtarlar bu şablon dosyasında BOŞ bırakılmıştır):

# Vercel Postgres kullanıyorsanız (Vercel projenize eklediğinizde
# bu değişkenler Vercel tarafından otomatik olarak sağlanır):
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# Supabase kullanıyorsanız:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# ÖNEMLİ GÜVENLİK NOTU
# ============================================================
# Bu dosyaya ASLA gerçek API anahtarı, token veya şifre yazmayın.
# Gerçek değerleri yalnızca kendi ".env.local" dosyanızda (commit
# edilmeyen) veya Vercel projenizin "Environment Variables" panelinde
# tutun.